# 1. Corriger les types MIME pour les modules JavaScript
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
</IfModule>

# 2. Rediriger toutes les requêtes vers index.html (pour SPA React / React Router)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>